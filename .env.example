# The address of this app, with no slash at the end.
APP_URL=http://localhost:3000

# Supabase project. For the local database, get the values from "bunx supabase status".
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Email addresses of the admins, separated by commas.
ADMIN_USERS=

# The folder of model folders: a local path, or hf://datasets/<user>/<name>.
MODELS_SOURCE=../ua-tts-bench/.cache/ua-tts-eval

# Optional. A Hugging Face token for a private dataset.
HF_TOKEN=

# The dataset file: a local path or a URL.
DATASET_SOURCE=../ua-tts-eval/src/ua_tts_eval/data/dataset.jsonl

# Shows a form that signs in with only an email address.
# It works only if SUPABASE_URL points to this machine.
LOCAL_SIGN_IN=true
